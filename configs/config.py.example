"""Configuration Template for fragile_compasion.

Copy this file to `configs/config.py` and populate your API key.
DO NOT commit `configs/config.py` to Git.
"""

from pathlib import Path

# API Credentials & Setup
OPENROUTER_API_KEY = "sk-or-v1-YOUR-ACTUAL-OPENROUTER-KEY-HERE"
OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"
TEACHER_MODEL = "deepseek/deepseek-v4-flash-0731"

# Directory Paths relative to Repository Root
CONFIGS_DIR = Path(__file__).resolve().parent
ROOT_DIR = CONFIGS_DIR.parent

PROMPTS_DIR = CONFIGS_DIR / "prompts"
CONTEXT_DIR = ROOT_DIR / "context"
OUTPUT_DIR = ROOT_DIR / "output"

# Ensure runtime directories exist
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

# Pipeline Defaults
DEFAULT_TEMPERATURE = 0.3
DEFAULT_SYSTEM_PROMPT_PATH = PROMPTS_DIR / "docgen_system_prompt.md"
DEFAULT_CONTEXT_PATH = CONTEXT_DIR / "excerpt.txt"