# Configuration Template for SFT Document Generation (Fragile Compassion)
# Copy this file to configs/sft_doc_config.yaml and populate your OpenRouter API key.
# DO NOT commit configs/sft_doc_config.yaml to version control.

api:
  openrouter_api_key: "sk-or-v1-YOUR-ACTUAL-OPENROUTER-KEY-HERE"
  openrouter_base_url: "https://openrouter.ai/api/v1"
  teacher_model: "deepseek/deepseek-v4-flash-0731"

defaults:
  teacher_model: "deepseek/deepseek-v4-flash-0731"
  temperature: 0.3
  system_prompt_path: "configs/prompts/docgen_system_prompt.md"
  context_path: "context/excerpt.txt"
  raw_book_path: "context/raw/sample_book.md"
  chunk_size_words: 1500                          # Target word count per excerpt
  filter_data_dense: true                      # Toggle filtering for numerical/table data
  min_data_score: 5
  chunks_dir: "context/chunks"                    # Output directory for processed chunks
  output_dir: "output"