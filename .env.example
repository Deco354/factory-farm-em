# Judge (Gemini via Inspect's google provider)
GOOGLE_API_KEY=

# Optional: raises Hugging Face rate limits for dataset/adapter downloads
HF_TOKEN=

# Optional: connect Inspect to an already-running vLLM server instead of auto-starting one
# VLLM_BASE_URL=http://gpu-box:8000/v1
# VLLM_API_KEY=inspectai

# Optional: where runtime-fetched benchmark items are cached (default ~/.cache/fragile-compassion)
# FC_CACHE_DIR=
