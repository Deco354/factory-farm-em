# Judge (configs/judge.yaml: OpenAI via Inspect's openai provider). Inspect reads exactly
# this name; a key stored as OPEN_AI_KEY is not seen.
OPENAI_API_KEY=

# Optional: a Gemini judge (model: google/...) or the experiments/judge_selection scripts
# GOOGLE_API_KEY=

# Optional: an OpenRouter-hosted second judge (e.g. GLM) for the calibration set in
# docs/judge-selection.md A.6. Inspect reads exactly this name (not OPEN_ROUTER_API_KEY).
# OPENROUTER_API_KEY=

# Required for fc_tac: its scenarios are a gated dataset. Accept the terms at
# https://huggingface.co/datasets/CompassioninMachineLearning/tac with this token's account.
# Also raises Hugging Face rate limits for the other dataset/adapter downloads.
HF_TOKEN=

# Optional: connect Inspect to an already-running vLLM server instead of auto-starting one
# VLLM_BASE_URL=http://gpu-box:8000/v1
# VLLM_API_KEY=inspectai

# Optional: where runtime-fetched benchmark items are cached (default ~/.cache/fragile-compassion)
# FC_CACHE_DIR=
